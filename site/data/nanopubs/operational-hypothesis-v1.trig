@prefix this: <http://purl.org/nanopub/temp/delphi-evolve/operational-hypothesis-v1> .
@prefix sub: <http://purl.org/nanopub/temp/delphi-evolve/operational-hypothesis-v1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix de: <urn:x-delphi-evolve:vocab#> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:hypothesis a delphi:Claim, delphi:TestableHypothesis ;
    rdfs:label "Operational TrpB step-dominance question (four-site landscape)" ;
    dct:description "On the finite measured four-site TrpB landscape (positions 183, 184, 227, 228 of the source study), does a route of single amino-acid substitutions from the parent VFVS to the highest measured genotype AIKG exist in which every step is non-decreasing in measured growth under a stated assumed error bound? This is a statement about a measured, finite graph and a growth-selection proxy, not about organisms, kcat/KM, or biological impossibility." ;
    dct:type "operational-hypothesis" ;
    de:evidenceKind "observed measurements, descriptive graph analysis; assumed error bound is a parameter, not a measured confidence level" ;
    de:motivatedBy <https://w3id.org/delphi/resource/claim/darwin1859-ch06-08> ;
    de:relationToMotivation "motivation-by-analogy; NOT equivalent to, entailed by, or a test of the Darwin 1859 statement" .

}

sub:provenance {
  sub:assertion prov:wasAttributedTo sub:softwareAgent ;
    prov:wasGeneratedBy sub:generation .
  sub:softwareAgent a prov:SoftwareAgent ;
    rdfs:label "Delphi Evolve experience worker (Claude Sonnet 5.5 driving evolve/evidence.py)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith sub:softwareAgent ;
    rdfs:comment "Generated by `python -m evolve.evidence nanopubs`; see repository for the exact commit." .
  <https://w3id.org/delphi/resource/claim/darwin1859-ch06-08> rdfs:label "Darwin 1859 ch. VI claim: theory fails if a complex organ could not arise by slight steps" ;
    de:observedInDelphiSource "local", "network" ;
    de:delphiNetworkNanopub <https://w3id.org/np/RAJN9-vmRYhQZuloSCaF9rPE2_wnkcoTI4XxbYcVt_uS4> .
  sub:assertion prov:wasDerivedFrom <https://doi.org/10.1073/pnas.2400439121>, <https://data.caltech.edu/records/h5rah-5z170> .
  <https://data.caltech.edu/records/h5rah-5z170> dct:license <https://creativecommons.org/publicdomain/zero/1.0/> ;
    rdfs:label "CaltechDATA record h5rah-5z170 (Johnston et al. TrpB combinatorial landscape)" ;
    spdx:checksum [ spdx:algorithm spdx:checksumAlgorithm_sha256 ; spdx:checksumValue "a631d8cf6c5b188a801555cc4117547a1bf8e294240e1757c2d2d78dcb25ee82" ;
                    rdfs:comment "SHA-256 of summary_AA.csv as retrieved by this project" ] .

}

sub:pubinfo {
  this: dct:created "2026-10-31T07:22:21Z"^^xsd:dateTime ;
    rdfs:label "Draft: operational TrpB route hypothesis" ;
    npx:hasNanopubType delphi:Claim ;
    de:signatureStatus "UNSIGNED DRAFT: no trusty URI assigned, not published to any nanopub network" ;
    rdfs:comment "Draft only. Temporary URIs (purl.org/nanopub/temp) are replaced when signed by a real key holder. No scientist identity or endorsement is asserted." .
}
