@prefix this: <http://purl.org/nanopub/temp/scopedesk/np> .
@prefix sub: <http://purl.org/nanopub/temp/scopedesk/np#> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:review a schema:ClaimReview ;
    schema:name "Scope verdict: turing-ddi on regime f40359afc75c: survived" ;
    schema:claimReviewed "Under the declared two-species linearization J, diffusivities D and domain/boundary, at least one admissible Laplacian mode has a strictly growing linear eigenvalue (det(J - qD) < 0)." ;
    schema:itemReviewed <https://w3id.org/np/RAaQ-9SCjYC7GBJ0ZtrPcVNxZBB7z-VNAdWa8ImGAi610> ;
    schema:reviewRating sub:rating ;
    schema:additionalProperty sub:p0, sub:p1, sub:p2, sub:p3, sub:p4, sub:p5, sub:p6, sub:p7, sub:p8, sub:p9, sub:p10, sub:p11, sub:p12, sub:p13, sub:p14, sub:p15, sub:p16, sub:p17 .
  sub:rating a schema:Rating ;
    schema:alternateName "survived" ;
    schema:ratingExplanation "the classical result's instability DOES occur (an admissible mode grows linearly) in this regime. Classical result cited: Turing diffusion-driven instability: a homogeneous steady state of two reacting chemicals that is stable without diffusion can become unstable to spatial perturbations when the chemicals diffuse at different rates (linearization about a homogeneous steady state, fixed domain, no growth or mechanics)." .
  sub:p0 a schema:PropertyValue ; schema:name "regime_sha256" ; schema:value "f40359afc75cbcd74b3159cf21359b177682a326f3125fffe4d3cd81e1e24293" .
  sub:p1 a schema:PropertyValue ; schema:name "kinetics" ; schema:value "caller-declared jacobian" .
  sub:p2 a schema:PropertyValue ; schema:name "jacobian" ; schema:value "[[\"1\", \"-2\"], [\"2\", \"-3\"]]" .
  sub:p3 a schema:PropertyValue ; schema:name "diffusivities" ; schema:value "[\"1\", \"10\"]" .
  sub:p4 a schema:PropertyValue ; schema:name "dimension" ; schema:value "1" .
  sub:p5 a schema:PropertyValue ; schema:name "boundary" ; schema:value "neumann" .
  sub:p6 a schema:PropertyValue ; schema:name "length" ; schema:value "[\"2\"]" .
  sub:p7 a schema:PropertyValue ; schema:name "length_unit" ; schema:value "multiples of pi" .
  sub:p8 a schema:PropertyValue ; schema:name "verdict" ; schema:value "pattern_possible" .
  sub:p9 a schema:PropertyValue ; schema:name "outcome" ; schema:value "survived" .
  sub:p10 a schema:PropertyValue ; schema:name "unstable_mode_count" ; schema:value "1" .
  sub:p11 a schema:PropertyValue ; schema:name "unstable_mode_witness_exact" ; schema:value "[{\"index\": 1, \"q\": \"1/4\", \"trace\": \"-19/4\", \"determinant\": \"-1/8\"}]" .
  sub:p12 a schema:PropertyValue ; schema:name "critical_length_over_pi_verified_bracket" ; schema:value "[\"1414213562373/1000000000000\", \"707106781187/500000000000\"]" .
  sub:p13 a schema:PropertyValue ; schema:name "required_inhibitor_over_activator_diffusion_ratio_greater_than_bracket" ; schema:value "[\"9\", \"4500000000001/500000000000\"]" .
  sub:p14 a schema:PropertyValue ; schema:name "independent_checks_agree" ; schema:value "{\"finite_difference_eigenvalues\": true, \"turing_scope_adapter\": true}" .
  sub:p15 a schema:PropertyValue ; schema:name "engine_version" ; schema:value "0.1.0" .
  sub:p16 a schema:PropertyValue ; schema:name "evidence_type" ; schema:value "model-derived; observed: none" .
  sub:p17 a schema:PropertyValue ; schema:name "scope_limit" ; schema:value "linear stability of the declared two-species linearization only; no nonlinear pattern, biological, wet-lab or clinical implication" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://github.com/kganjam/delphi-evolve> ;
    prov:wasDerivedFrom <https://w3id.org/np/RAaQ-9SCjYC7GBJ0ZtrPcVNxZBB7z-VNAdWa8ImGAi610>, <https://github.com/kganjam/delphi-evolve/tree/09b895f62f230edb39cd433e19f10fda3275a60b/falsify> ;
    prov:wasGeneratedBy sub:generation .
  <https://github.com/kganjam/delphi-evolve> a prov:SoftwareAgent ; rdfs:label "delphi-evolve falsify service (software; exact-rational engine, optional Lean checker)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith <https://github.com/kganjam/delphi-evolve> ;
    rdfs:comment "Computed by falsify 0.1.0 at the cited commit; receipt id local. Source pin of the cited Delphi record verified (content sha256 43de1d39496e0d2a8df133d0e537bed158bf3c68d23c28a764c2356715aa4f66)." .
}

