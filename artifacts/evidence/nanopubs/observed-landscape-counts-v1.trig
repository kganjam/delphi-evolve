@prefix this: <http://purl.org/nanopub/temp/delphi-evolve/observed-landscape-counts-v1> .
@prefix sub: <http://purl.org/nanopub/temp/delphi-evolve/observed-landscape-counts-v1/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix de: <urn:x-delphi-evolve:vocab#> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:observation a delphi:Claim ;
    rdfs:label "Counts in the TrpB four-site source tables as retrieved" ;
    dct:description "Of 160000 amino-acid genotypes, 159129 are present with replicate measurements in summary_AA.csv (non-stop rows); 871 are absent. The source ships 871 KNN-imputed rows for the absent genotypes; overlap with measured rows is 0. Imputed values are not observations." ;
    dct:type "observation" ;
    de:measuredNonStop 159129 ;
    de:unmeasured 871 ;
    de:imputedRowsInSource 871 ;
    de:measuredImputedOverlap 0 .

}

sub:provenance {
  sub:assertion prov:wasAttributedTo sub:softwareAgent ;
    prov:wasGeneratedBy sub:generation .
  sub:softwareAgent a prov:SoftwareAgent ;
    rdfs:label "Delphi Evolve experience worker (Claude Sonnet 5.5 driving evolve/evidence.py)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith sub:softwareAgent ;
    rdfs:comment "Generated by `python -m evolve.evidence nanopubs`; see repository for the exact commit." .
  sub:assertion prov:wasDerivedFrom <https://data.caltech.edu/records/h5rah-5z170> .
  <https://data.caltech.edu/records/h5rah-5z170> spdx:checksum [ spdx:algorithm spdx:checksumAlgorithm_sha256 ;
      spdx:checksumValue "a631d8cf6c5b188a801555cc4117547a1bf8e294240e1757c2d2d78dcb25ee82" ; rdfs:comment "summary_AA.csv" ],
    [ spdx:algorithm spdx:checksumAlgorithm_sha256 ;
      spdx:checksumValue "83b4db9f82fe8d09c4bf7006f3cc730d511eee12147e8fe2e9198281960f34c4" ; rdfs:comment "KNN_imputed_TrpB.csv" ] .

}

sub:pubinfo {
  this: dct:created "2026-10-31T07:15:26Z"^^xsd:dateTime ;
    rdfs:label "Draft: observed landscape counts" ;
    npx:hasNanopubType delphi:Claim ;
    de:signatureStatus "UNSIGNED DRAFT: no trusty URI assigned, not published to any nanopub network" ;
    rdfs:comment "Draft only. Temporary URIs (purl.org/nanopub/temp) are replaced when signed by a real key holder. No scientist identity or endorsement is asserted." .
}
