sub:assertion {
  <https://w3id.org/delphi/resource/claim/kimura-fixation-probability> a <https://w3id.org/delphi/ontology/Claim>,
      <https://w3id.org/delphi/ontology/TestableHypothesis>;
    dc:description "The probability that a mutant allele eventually fixes in a finite population depends on its initial frequency, its selective advantage and the effective population size, and equals its initial frequency when it is neutral.";
    dc:source "Motoo Kimura (1962) On the probability of fixation of mutant genes in a population";
    <http://www.w3.org/2000/01/rdf-schema#label> "Kimura fixation probability of a mutant allele";
    <http://www.w3.org/2004/02/skos/core#notation> "u(p) = \\frac{1-e^{-4N_e s p}}{1-e^{-4N_e s}}; neutral limit u(p) = p, so a new mutant fixes with probability 1/(2N)";
    <https://w3id.org/delphi/ontology/context> "Assumptions: diffusion approximation to the Wright-Fisher model, genic (additive) selection with coefficient s, constant effective size N_e, no linkage to other selected sites. Formal status: proved within the diffusion limit.";
    <https://w3id.org/delphi/ontology/hypothesisType> "model-theorem";
    <https://w3id.org/delphi/ontology/proposedTest> "Track the fate of many marked mutations of measured fitness effect in replicate experimental populations of known N_e (e.g. barcoded microbial lineages) and compare fixation frequencies with u(p)." .
}

