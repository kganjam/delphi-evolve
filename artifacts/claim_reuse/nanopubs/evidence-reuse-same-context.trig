@prefix this: <http://purl.org/nanopub/temp/delphi-evolve/claim-reuse/evidence-reuse-same-context> .
@prefix sub: <http://purl.org/nanopub/temp/delphi-evolve/claim-reuse/evidence-reuse-same-context/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix de: <urn:x-delphi-evolve:vocab#> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:reuse a de:EvidenceReuse ;
    rdfs:label "Evidence reuse decision: reuse" ;
    de:decision "reuse" ;
    de:reason "valid same-context observed evidence" ;
    de:evidenceId "7e72dd92ec7d93d33a69a93a33387738323e38fa0c183625dab0becfabf9e1ca" ;
    de:evidenceKind "observed" ;
    de:subjectGenotype "CFVS" ;
    de:datasetSha256 "a631d8cf6c5b188a801555cc4117547a1bf8e294240e1757c2d2d78dcb25ee82" ;
    de:assayContextId "be6e5edfa5813bd3f2a39072de4db3141b42c22b96a28fa9b5b271b7114f9392" ;
    de:referenceSha256 "f74260ce69d3eb224de1e90d7e687f404da225d62eac7c553d478d044b05ae8c" ;
    de:units "integer micro-units of raw growth-rate score mu minus per-replicate stop-codon mean (evolve.data, 1e-6 resolution)" ;
    de:observedScoreMicro 93346 .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo sub:softwareAgent ;
    prov:wasGeneratedBy sub:generation .
  sub:softwareAgent a prov:SoftwareAgent ;
    rdfs:label "claim_runtime (software; model Claude Sonnet 5.5 authored the adapter)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith sub:softwareAgent ;
    rdfs:comment "Generated by `python -m claim_runtime demo`; the value is an OBSERVED source-table score, reused, not newly measured." .
  sub:assertion prov:wasDerivedFrom <https://data.caltech.edu/records/h5rah-5z170> .
}

sub:pubinfo {
  this: dct:created "2026-10-31T08:04:50Z"^^xsd:dateTime ;
    rdfs:label "Draft: evidence reuse evidence-reuse-same-context" ;
    npx:hasNanopubType de:ClaimUse ;
    de:signatureStatus "UNSIGNED DRAFT: no trusty URI assigned, not published to any nanopub network" ;
    rdfs:comment "Draft only. Records a software use of an existing Delphi claim; it does not republish or endorse that claim." .
}
