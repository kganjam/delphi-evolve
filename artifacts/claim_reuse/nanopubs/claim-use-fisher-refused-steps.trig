@prefix this: <http://purl.org/nanopub/temp/delphi-evolve/claim-reuse/claim-use-fisher-refused-steps> .
@prefix sub: <http://purl.org/nanopub/temp/delphi-evolve/claim-reuse/claim-use-fisher-refused-steps/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix de: <urn:x-delphi-evolve:vocab#> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:use a de:ClaimUse ;
    rdfs:label "Use of https://w3id.org/delphi/resource/claim/fisher-ftns by fisher-ftns/partial-change" ;
    de:usesClaim <https://w3id.org/delphi/resource/claim/fisher-ftns> ;
    de:delphiSource "network" ;
    de:claimRecordResponseSha256 "bd87ef318815338e55a5336259eb1b7ea309ccfd6c9fd1ab4ecf24bd7689a76a" ;
    de:adapterId "fisher-ftns/partial-change" ;
    de:adapterVersion "1.0.0" ;
    de:adapterSourceSha256 "e9cebe8be5c0a8cee73ee739886c870c65e846f4ab6b223402f2f97db0e1ebe2" ;
    de:requestSha256 "a78f8ac4a78c739e6da86da08bbffdcb89dfd0e8c0606c9e4e56fcd36b879bbb" ;
    de:responseSha256 "c7a432b378d5ea9a3cbef0eb6712e4394ac3735a47cfe6e066833eada9bfb5a3" ;
    de:decision "refuse" ;
    de:reasonCode "inference_refused" ;
    de:epistemicStatus "none: computation refused" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo sub:softwareAgent ;
    prov:wasGeneratedBy sub:generation .
  sub:softwareAgent a prov:SoftwareAgent ;
    rdfs:label "claim_runtime (software; model Claude Sonnet 5.5 authored the adapter)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith sub:softwareAgent ;
    rdfs:comment "Generated by `python -m claim_runtime demo`; see repository commit for the exact code." .
  sub:assertion prov:wasDerivedFrom <https://w3id.org/np/RAtLFqIIyu4r-GlMcBEfmDtbV-CHwWxQ49gVMtHIX6r48> .
}

sub:pubinfo {
  this: dct:created "2026-10-31T08:04:50Z"^^xsd:dateTime ;
    rdfs:label "Draft: claim use record claim-use-fisher-refused-steps" ;
    npx:hasNanopubType de:ClaimUse ;
    de:signatureStatus "UNSIGNED DRAFT: no trusty URI assigned, not published to any nanopub network" ;
    rdfs:comment "Draft only. Records a software use of an existing Delphi claim; it does not republish or endorse that claim." .
}
