    rdfs:comment "Generated by `python -m claim_runtime demo`; see repository commit for the exact code." .
  sub:assertion prov:wasDerivedFrom <https://w3id.org/np/RA76F4g68zgxUhMgNanl8KsuUwKDJhYuUgXowdNzSsnMQ> .
}

sub:pubinfo {
  this: dct:created "2026-10-31T08:02:43Z"^^xsd:dateTime ;
