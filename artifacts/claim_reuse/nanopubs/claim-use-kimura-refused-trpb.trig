sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:use a de:ClaimUse ;
    rdfs:label "Use of https://w3id.org/delphi/resource/claim/kimura-fixation-probability by kimura-fixation-probability/diploid-genic-diffusion" ;
    de:usesClaim <https://w3id.org/delphi/resource/claim/kimura-fixation-probability> ;
    de:delphiSource "network" ;
    de:claimRecordResponseSha256 "8aa59e1c076386b62a73b2d8fa428cff5101bc06c4843505735bd14291386a36" ;
    de:adapterId "kimura-fixation-probability/diploid-genic-diffusion" ;
    de:adapterVersion "1.0.0" ;
    de:adapterSourceSha256 "60947e754be946ac22b5a7b5c1744f0aab3d4b922e70e36ae758e2a910c8b0d8" ;
    de:requestSha256 "474fc24a5e5eb3f2ba0699732765418122dc3f409e68c68d61f1544aa3bc4698" ;
    de:responseSha256 "2524c12b68fa479c60853a826de0870dfdc868043e70bf6c168e3191356cc653" ;
    de:decision "refuse" ;
    de:reasonCode "unsupported_quantity_conversion" ;
    de:epistemicStatus "none: computation refused" .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo sub:softwareAgent ;
    prov:wasGeneratedBy sub:generation .
  sub:softwareAgent a prov:SoftwareAgent ;
    rdfs:label "claim_runtime (software; model Claude Sonnet 5.5 authored the adapter)" .
  sub:generation a prov:Activity ;
    prov:wasAssociatedWith sub:softwareAgent ;
    rdfs:comment "Generated by `python -m claim_runtime demo`; see repository commit for the exact code." .
  sub:assertion prov:wasDerivedFrom <https://w3id.org/np/RA76F4g68zgxUhMgNanl8KsuUwKDJhYuUgXowdNzSsnMQ> .
}

sub:pubinfo {
  this: dct:created "2026-10-31T08:02:43Z"^^xsd:dateTime ;
    rdfs:label "Draft: claim use record claim-use-kimura-refused-trpb" ;
    npx:hasNanopubType de:ClaimUse ;
    de:signatureStatus "UNSIGNED DRAFT: no trusty URI assigned, not published to any nanopub network" ;
